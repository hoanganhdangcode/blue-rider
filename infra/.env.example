# Copy to infra/.env (never commit real secrets).
# JWT PEM values are optional in the base scaffold — services generate ephemeral keys if blank.

POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_URL=jdbc:postgresql://postgres:5432/blue_ride_postgres

INTERNAL_API_KEY=dev-internal-key

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_BROKERS=kafka:9092

MONGO_URI=mongodb://mongo:27017
MONGO_DB=blue_ride_operator
REDIS_ADDR=redis:6379

CORE_BASE_URL=http://core-service:8080
OPERATOR_BASE_URL=http://operator-service:8080

JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
