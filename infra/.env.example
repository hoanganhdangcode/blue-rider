# Copy to infra/.env (never commit real secrets).
# JWT PEM values are optional in the base scaffold — auth-service generates ephemeral keys if blank.

POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_URL=jdbc:postgresql://postgres:5432/blue_ride_postgres

INTERNAL_API_KEY=dev-internal-key

KAFKA_BOOTSTRAP_SERVERS=kafka:9092

MONGO_URI=mongodb://mongo:27017
MONGO_DB=blue_ride_core
REDIS_ADDR=redis:6379

AUTH_BASE_URL=http://auth-service:8080
CORE_BASE_URL=http://core-service:8080

JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=

# Local dev only (features branch, compose.local.yml): host port that
# gateway-service is published on, e.g. http://<YOUR_LAN_IP>:GATEWAY_PORT.
# Not used by compose.yml alone (test/production), where gateway stays
# internal behind Nginx.
GATEWAY_PORT=8080
